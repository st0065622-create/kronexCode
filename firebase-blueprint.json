{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Premium active founder security profile criteria",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100, "pattern": "^[a-zA-Z0-9\\s\\.\\-\\_]+$" },
        "username": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9\\_\\-]+$" },
        "email": { "type": "string", "maxLength": 150, "format": "email" },
        "phone": { "type": "string", "maxLength": 30 },
        "bio": { "type": "string", "maxLength": 500 },
        "country": { "type": "string", "maxLength": 80 },
        "language": { "type": "string", "maxLength": 50 },
        "twoFactor": { "type": "boolean" },
        "theme": { "type": "string", "enum": ["light", "dark", "system"] },
        "avatar": { "type": "string", "maxLength": 2048 }
      },
      "required": ["name", "username", "email"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "High-fidelity conversational workspace log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "date": { "type": "string", "maxLength": 50 },
        "model": { "type": "string", "maxLength": 80 },
        "messages": { "type": "array" }
      },
      "required": ["id", "title", "model", "messages"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Sovereign users profile data matching verified identity credentials"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "Autonomous sandbox AI conversation workspaces logs"
    }
  }
}
